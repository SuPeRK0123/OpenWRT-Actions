# =====================
# Target Platform
# mediatek/filogic (MT7981B - ARM Cortex-A53)
# =====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-v1=y

# =====================
# Wi-Fi 驱动（MT7981B 板载 Wi-Fi）
# =====================
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mac80211-hwsim=n

# =====================
# LuCI 基础界面
# =====================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Busybox 历史记录
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_HISTORY=1024
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVEHISTORY=y

# OpenSSL 性能优化
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y

# 时区数据（配合 Asia/Shanghai 设置）
CONFIG_PACKAGE_zoneinfo-asia=y

# Bash
CONFIG_PACKAGE_bash=y

# =====================
# USB 存储设备支持
# =====================
# CONFIG_PACKAGE_kmod-usb-storage=y
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-exfat=y

# =====================
# ttyd终端
# =====================
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# =====================
# DDNS
# =====================
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# =====================
# sing-box
# =====================
# CONFIG_PACKAGE_sing-box=y

# sing-box 运行时依赖的内核模块
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y
