# LuCI 基础界面
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

# dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq

# BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Bash
CONFIG_PACKAGE_bash=y

# Busybox 历史记录
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_HISTORY=1024
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVEHISTORY=y

# OpenSSL 性能优化
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y

# 时区数据（配合 Asia/Shanghai 设置）
CONFIG_PACKAGE_zoneinfo-asia=y

# sing-box
# CONFIG_PACKAGE_sing-box=y

# sing-box 运行时依赖的内核模块
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y

# ttyd 终端
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# WOL
# CONFIG_PACKAGE_luci-app-wol=y
# CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# UPnP
# CONFIG_PACKAGE_luci-app-upnp=y

# SQM QoS
# CONFIG_PACKAGE_luci-app-sqm=y

# Watchcat（定时重启或检测断网后自动重启）
# CONFIG_PACKAGE_luci-app-watchcat=y
# CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y

# SMB 文件共享
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# NATMap
# CONFIG_PACKAGE_luci-app-natmap=y
# CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y

# USB 存储设备支持
# CONFIG_PACKAGE_kmod-usb-storage=y
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-exfat=y
